<section class="auth-card">
    {{if .RegistrationClosed}}
    <div class="notice">Registration is closed. Ask an administrator to create or enable your account.</div>
    <p><a class="button" href="/login">Back to sign in</a></p>
    {{else}}
    {{if .Error}}<div class="notice error" role="alert">{{.Error}}</div>{{end}}
    {{if .NeedsSetup}}<div class="notice">This first verified account will become the administrator.</div>{{end}}
    <form method="POST" action="/register" class="stacked-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <label>Name
            <input type="text" name="name" value="{{.Name}}" autocomplete="name" maxlength="100" required>
        </label>
        <label>Email
            <input type="email" name="email" value="{{.Email}}" autocomplete="email" required>
        </label>
        <label>Password
            <input type="password" name="password" autocomplete="new-password" minlength="10" required>
            <small>At least 10 characters.</small>
        </label>
        <label>Confirm password
            <input type="password" name="password_confirm" autocomplete="new-password" minlength="10" required>
        </label>
        <button type="submit" class="button primary">Create account</button>
    </form>
    <p class="auth-note">Already registered? <a href="/login">Sign in</a>.</p>
    {{end}}
</section>
