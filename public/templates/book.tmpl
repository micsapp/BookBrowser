{{with .Book}}
<div class="single-book">
    <div class="cover">
        {{if .HasCover}}
        <img src="/covers/{{.ID}}.jpg" alt="cover">
        {{else}}
        <img src="/static/nocover.jpg" alt="cover">
        {{end}}
        <div class="buttons">
            <a href="/download/{{.ID}}.{{.FileType}}" class="button download">Download {{ .FileType | ToUpper }}</a>
            {{if eq .FileType "epub"}}
            {{if $.LoggedIn}}
            <a class="button read" href="/read/{{.ID}}">Read</a>
            {{else}}
            <a class="button read" href="/static/reader/epub/#!/download/{{.ID}}.{{.FileType}}">Read</a>
            {{end}}
            {{end}} {{if eq .FileType "pdf"}}
            {{if $.LoggedIn}}
            <a class="button read" href="/read/{{.ID}}">Read</a>
            {{else}}
            <a class="button read" href="/static/reader/pdf/web/viewer.html?file=/download/{{.ID}}.{{.FileType}}">Read</a>
            {{end}}
            {{end}}
        </div>
    </div>
    <div class="meta">
        <div class="title">{{.Title}}</div>
        {{if .Author}}
        <a href="/authors/{{.AuthorID}}" class="author">{{.Author}}</a>
        {{end}} {{if .Series}}
        <div class="series">
            <a href="/series/{{.SeriesID}}" class="name">{{.Series}}</a> -
            <span class="index">{{.SeriesIndex}}</span>
        </div>
        {{end}} {{if .Description}}
        <div class="description">
            {{.Description | raw}}
        </div>
        {{end}}
        {{if .PublishDate}}
        <div>{{.PublishDate.Format "Jan, 2006"}}</div>
        {{end}}
        {{if .ISBN}}
        <div>ISBN: {{.ISBN}}</div>
        {{end}}
        {{if $.LoggedIn}}
        <section class="personal-book-tools" aria-labelledby="personal-book-heading">
            <div class="personal-book-heading">
                <div>
                    <span class="personal-eyebrow">Private to your account</span>
                    <h2 id="personal-book-heading">Lists &amp; tags</h2>
                </div>
                <a href="/my-library">Manage My Library</a>
            </div>
            {{if $.Saved}}<div class="notice success compact-notice">Saved to your library.</div>{{end}}
            {{if $.Error}}<div class="notice error compact-notice">{{$.Error}}</div>{{end}}

            <div class="personal-tool-group">
                <strong>Favorite lists</strong>
                <div class="personal-chip-row">
                    {{range $.BookLists}}
                    {{if .ContainsBook}}
                    <form method="POST" action="/my-library/lists/{{.ID}}/books/{{$.Book.ID}}/remove">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <input type="hidden" name="next" value="/books/{{$.Book.ID}}">
                        <button type="submit" class="personal-chip selected" title="Remove from {{.Name}}">✓ {{.Name}}</button>
                    </form>
                    {{else}}
                    <form method="POST" action="/my-library/lists/{{.ID}}/books/{{$.Book.ID}}">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <input type="hidden" name="next" value="/books/{{$.Book.ID}}">
                        <button type="submit" class="personal-chip" title="Add to {{.Name}}">+ {{.Name}}</button>
                    </form>
                    {{end}}
                    {{else}}
                    <span class="personal-empty">Create your first named list in My Library.</span>
                    {{end}}
                </div>
            </div>

            <div class="personal-tool-group">
                <strong>Your tags</strong>
                <div class="personal-chip-row">
                    {{range $.BookTags}}
                    <form method="POST" action="/books/{{$.Book.ID}}/tags/remove">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <input type="hidden" name="tag" value="{{.}}">
                        <button type="submit" class="personal-chip selected" title="Remove tag {{.}}">{{.}} <span aria-hidden="true">×</span></button>
                    </form>
                    {{end}}
                </div>
                <form method="POST" action="/books/{{.ID}}/tags" class="tag-add-form">
                    <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                    <input type="text" name="tag" maxlength="40" placeholder="Add a tag, e.g. History" aria-label="New tag" required>
                    <button type="submit" class="button compact">Add tag</button>
                </form>
            </div>
        </section>
        {{if $.CurrentUser.AllowShare}}
        <section class="share-book" data-site-name="{{$.SiteName}}" aria-labelledby="share-heading">
            <div class="personal-book-heading">
                <div>
                    <span class="personal-eyebrow">Share this book</span>
                    <h2 id="share-heading">Send a link to {{$.SiteName}}</h2>
                </div>
            </div>
            <p class="share-note">Open this book right here. Or push it to a chat or social app.</p>
            <div class="share-row">
                <button type="button" class="share-btn share-native" data-share-native>Share…</button>
                <a class="share-btn share-whatsapp" data-share-network="whatsapp" href="#" target="_blank" rel="noopener">WhatsApp</a>
                <a class="share-btn share-telegram" data-share-network="telegram" href="#" target="_blank" rel="noopener">Telegram</a>
                <a class="share-btn share-facebook" data-share-network="facebook" href="#" target="_blank" rel="noopener">Facebook</a>
                <a class="share-btn share-twitter" data-share-network="twitter" href="#" target="_blank" rel="noopener">X</a>
            </div>
            <div class="share-copy">
                <input type="text" readonly value="{{$.PageURL}}" data-share-link aria-label="Share link">
                <button type="button" class="button compact" data-share-copy>Copy link</button>
                <span class="share-copied" data-share-copied hidden>Copied!</span>
            </div>
        </section>
        {{end}}
        {{end}}
        <div class="buttons">
            <a href="/download/{{.ID}}.{{.FileType}}" class="button download">Download {{ .FileType | ToUpper }}</a>
            {{if eq .FileType "epub"}}
            {{if $.LoggedIn}}
            <a class="button read" href="/read/{{.ID}}">Read</a>
            {{else}}
            <a class="button read" href="/static/reader/epub/#!/download/{{.ID}}.{{.FileType}}">Read</a>
            {{end}}
            {{end}} {{if eq .FileType "pdf"}}
            {{if $.LoggedIn}}
            <a class="button read" href="/read/{{.ID}}">Read</a>
            {{else}}
            <a class="button read" href="/static/reader/pdf/web/viewer.html?file=/download/{{.ID}}.{{.FileType}}">Read</a>
            {{end}}
            {{end}}
        </div>
    </div>
</div>
{{end}}
<script>
    (function () {
        var section = document.querySelector("[data-share-link]");
        if (!section) return;
        var input = section;
        var url = input.value;
        var title = document.querySelector(".single-book .title");
        title = title ? title.textContent.trim() : "";
        var siteName = document.querySelector(".share-book").getAttribute("data-site-name") || "";
        var text = title && siteName ? title + " – read it on " + siteName : url;

        var networks = {
            whatsapp: function () {
                return "https://wa.me/?text=" + encodeURIComponent(text + "\n" + url);
            },
            telegram: function () {
                return "https://t.me/share/url?url=" + encodeURIComponent(url) + "&text=" + encodeURIComponent(text);
            },
            facebook: function () {
                return "https://www.facebook.com/sharer/sharer.php?u=" + encodeURIComponent(url);
            },
            twitter: function () {
                return "https://twitter.com/intent/tweet?url=" + encodeURIComponent(url) + "&text=" + encodeURIComponent(text);
            }
        };

        document.querySelectorAll("[data-share-network]").forEach(function (link) {
            link.addEventListener("click", function (event) {
                var builder = networks[link.getAttribute("data-share-network")];
                if (builder) {
                    event.preventDefault();
                    window.open(builder(), "_blank", "noopener,width=600,height=500");
                }
            });
        });

        var nativeButton = document.querySelector("[data-share-native]");
        if (nativeButton) {
            if (navigator.share) {
                nativeButton.addEventListener("click", function () {
                    navigator.share({ title: title, text: text, url: url }).catch(function () {});
                });
            } else {
                nativeButton.style.display = "none";
            }
        }

        var copied = document.querySelector("[data-share-copied]");
        var copyButton = document.querySelector("[data-share-copy]");
        copyButton.addEventListener("click", function () {
            function done() {
                copied.hidden = false;
                window.setTimeout(function () { copied.hidden = true; }, 1800);
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(done, function () { fallback(); });
            } else {
                fallback();
            }
            function fallback() {
                input.focus();
                input.select();
                try {
                    document.execCommand("copy");
                    done();
                } catch (e) {}
            }
        });
    })();
</script>
