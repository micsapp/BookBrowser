<section class="admin-shell">
    <nav class="admin-tabs">
        <a href="/admin">Overview</a>
        {{if .IsAdmin}}<a href="/admin/users">Users</a>{{end}}
        <a class="active" href="/admin/library">Library</a>
        <a href="/admin/library/add">Add books</a>
        <a href="/admin/requests">Requests</a>
        {{if .IsAdmin}}<a href="/admin/copyright" data-i18n="admin_copyright_tab">Copyright claims</a>{{end}}
        {{if .IsAdmin}}<a href="/admin/settings">Settings</a>{{end}}
    </nav>
    {{if eq .Saved "added"}}<div class="notice success">{{.Msg}}</div>{{end}}
    {{if eq .Saved "queued"}}<div class="notice success">{{.Msg}}</div>{{end}}
    {{if eq .Saved "uploaded"}}<div class="notice success">Book uploaded. The library is being re-indexed.</div>{{end}}
    {{if eq .Saved "removed"}}<div class="notice success">Book moved to recoverable storage. The library is being re-indexed.</div>{{end}}
    {{if eq .Saved "rescan"}}<div class="notice success">Library rescan started.</div>{{end}}
    {{if .Error}}<div class="notice error" role="alert">{{.Error}}</div>{{end}}
    <div class="admin-actions">
        <form method="POST" action="/admin/library/upload" enctype="multipart/form-data" class="upload-form">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <label>Upload ebook (maximum {{.MaxUploadMB}} MiB)
                <input type="file" name="book" accept=".epub,.pdf,.mobi" required>
            </label>
            <button type="submit" class="button primary">Upload</button>
        </form>
        <form method="POST" action="/admin/library/rescan">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <button type="submit" class="button">Rescan library</button>
        </form>
    </div>
    <div class="libgen-jobs" id="libgen-jobs" hidden>
        <h3>Downloads in progress</h3>
        <div class="libgen-jobs-list" id="libgen-jobs-list"></div>
    </div>

    <div class="admin-filters" role="search">
        <input type="search" id="library-filter" class="admin-filter-input" placeholder="Filter by title or author…" autocomplete="off" aria-label="Filter books by title or author">
        <label class="admin-filter-label">Type
            <select id="library-format" class="admin-filter-select" aria-label="Filter books by type">
                <option value="">All types</option>
                <option value="epub">EPUB</option>
                <option value="pdf">PDF</option>
                <option value="mobi">MOBI</option>
            </select>
        </label>
        <label class="admin-filter-label">Sort by
            <select id="library-sort" class="admin-filter-select" aria-label="Sort books">
                <option value="added-desc" selected>Newest added</option>
                <option value="added-asc">Oldest added</option>
                <option value="title-asc">Title A–Z</option>
                <option value="title-desc">Title Z–A</option>
                <option value="author-asc">Author A–Z</option>
                <option value="author-desc">Author Z–A</option>
            </select>
        </label>
        <span id="library-count" class="filter-count" aria-live="polite"></span>
    </div>

    <div class="table-scroll">
        <table class="admin-table">
            <thead><tr><th>Book</th><th>Author</th><th>Type</th><th>Added</th><th>Action</th></tr></thead>
            <tbody>
            {{range .Books}}
            <tr data-added="{{.ModTime.Unix}}" data-title="{{.Title}}" data-author="{{.Author}}" data-type="{{.FileType}}">
                <td><a href="/books/{{.ID}}"><strong>{{.Title}}</strong></a></td>
                <td>{{.Author}}</td>
                <td>{{.FileType | ToUpper}}</td>
                <td class="added-cell">{{.ModTime.Format "2006-01-02"}}</td>
                <td>
                    <form method="POST" action="/admin/library/delete/{{.ID}}" onsubmit="return confirm('Move this book to recoverable storage?');">
                        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                        <button type="submit" class="button danger compact">Remove</button>
                    </form>
                </td>
            </tr>
            {{end}}
            <tr id="library-empty" hidden><td colspan="5">No books match your filter.</td></tr>
            </tbody>
        </table>
    </div>

    <script>
        (function () {
            var panel = document.getElementById("libgen-jobs");
            var list = document.getElementById("libgen-jobs-list");
            if (!panel || !list) {
                return;
            }
            var esc = function (s) {
                return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
                    return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
                });
            };
            var poll = function () {
                fetch("/admin/library/add/status").then(function (r) {
                    return r.json();
                }).then(function (data) {
                    var jobs = (data && data.jobs) || [];
                    var active = jobs.filter(function (j) { return j.state === "downloading"; });
                    var recent = jobs.filter(function (j) { return j.state !== "downloading"; }).slice(-5);
                    var rows = [];
                    active.forEach(function (j) {
                        rows.push('<div class="libgen-job libgen-job-active"><span class="libgen-spinner-sm" aria-hidden="true"></span> <strong>' + esc(j.title) + '</strong> — downloading…</div>');
                    });
                    recent.forEach(function (j) {
                        var cls = j.state === "added" ? "libgen-job-ok" : "libgen-job-err";
                        var label = j.state === "added" ? "added" : "failed" + (j.error ? ": " + j.error : "");
                        rows.push('<div class="libgen-job ' + cls + '"><strong>' + esc(j.title) + '</strong> — ' + esc(label) + '</div>');
                    });
                    list.innerHTML = rows.join("");
                    panel.hidden = rows.length === 0;
                }).catch(function () {
                    panel.hidden = true;
                });
            };
            poll();
            setInterval(poll, 3000);
        })();
    </script>

    <script>
        (function () {
            var table = document.querySelector(".admin-table");
            if (!table) {
                return;
            }
            var tbody = table.querySelector("tbody");
            var empty = document.getElementById("library-empty");
            var filter = document.getElementById("library-filter");
            var format = document.getElementById("library-format");
            var sort = document.getElementById("library-sort");
            var count = document.getElementById("library-count");
            var rows = Array.prototype.slice.call(tbody.querySelectorAll("tr[data-added]"));
            var meta = rows.map(function (row) {
                return {
                    row: row,
                    added: parseInt(row.getAttribute("data-added"), 10) || 0,
                    title: (row.getAttribute("data-title") || "").toLowerCase(),
                    author: (row.getAttribute("data-author") || "").toLowerCase(),
                    type: (row.getAttribute("data-type") || "").toLowerCase()
                };
            });
            var sorters = {
                "added-desc": function (a, b) { return b.added - a.added || a.title.localeCompare(b.title); },
                "added-asc": function (a, b) { return a.added - b.added || a.title.localeCompare(b.title); },
                "title-asc": function (a, b) { return a.title.localeCompare(b.title); },
                "title-desc": function (a, b) { return b.title.localeCompare(a.title); },
                "author-asc": function (a, b) { return a.author.localeCompare(b.author) || a.title.localeCompare(b.title); },
                "author-desc": function (a, b) { return b.author.localeCompare(a.author) || a.title.localeCompare(b.title); }
            };
            function apply() {
                var q = (filter && filter.value || "").trim().toLowerCase();
                var type = format && format.value ? format.value.toLowerCase() : "";
                var key = sort && sort.value || "added-desc";
                var visible = meta.filter(function (item) {
                    if (type && item.type !== type) return false;
                    if (!q) return true;
                    return item.title.indexOf(q) !== -1 || item.author.indexOf(q) !== -1;
                });
                var shown = {};
                visible.forEach(function (item) { shown[item.row] = true; });
                visible.sort(sorters[key] || sorters["added-desc"]);
                visible.forEach(function (item) {
                    item.row.hidden = false;
                    tbody.appendChild(item.row);
                });
                meta.forEach(function (item) {
                    if (!shown[item.row]) item.row.hidden = true;
                });
                if (empty) {
                    empty.hidden = visible.length !== 0;
                    tbody.appendChild(empty);
                }
                if (count) {
                    count.textContent = visible.length + " of " + meta.length + " books";
                }
            }
            [filter, format, sort].forEach(function (el) {
                if (!el) return;
                el.addEventListener("input", apply);
                el.addEventListener("change", apply);
            });
            apply();
        })();
    </script>
</section>
