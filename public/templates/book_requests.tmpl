<main class="requests-shell">
    {{if .Saved}}<div class="notice success">Your request was submitted. A manager will review it, and the outcome will appear here.</div>{{end}}
    {{if .Error}}<div class="notice error">{{.Error}}</div>{{end}}

    <div class="requests-heading">
        <div>
            <span class="personal-eyebrow">Missing a title?</span>
            <h2>My book requests</h2>
        </div>
        <button type="button" class="button primary book-request-open-button">Request a book</button>
    </div>

    {{if .Requests}}
    <div class="request-list">
        {{range .Requests}}
        <article class="request-card">
            <header class="request-card-head">
                <div>
                    <strong>{{.Title}}</strong>
                    {{if .Author}}<small>by {{.Author}}</small>{{end}}
                </div>
                <span class="request-status request-status-{{.Status}}">
                    {{if eq .Status "pending"}}Pending review{{else if eq .Status "added"}}Added{{else}}Not found{{end}}
                </span>
            </header>
            {{if .Notes}}<p class="request-notes">{{.Notes}}</p>{{end}}
            {{if eq .Status "added"}}
            <p class="request-resolution request-resolution-added">
                <i class="fa fa-check" aria-hidden="true"></i>
                {{if .BookID}}
                The book was added to the library:
                <a href="/books/{{.BookID}}">{{if .BookTitle}}{{.BookTitle}}{{else}}Open the book{{end}}</a>
                {{else}}
                The book was added to the library.
                {{end}}
                {{if .Message}}<small>{{.Message}}</small>{{end}}
            </p>
            {{else if eq .Status "unavailable"}}
            <p class="request-resolution request-resolution-unavailable">
                <i class="fa fa-times" aria-hidden="true"></i>
                {{if .Message}}{{.Message}}{{else}}The book could not be found.{{end}}
            </p>
            {{end}}
            <time class="request-created" datetime="{{.CreatedAt}}">Requested {{.CreatedText}}</time>
        </article>
        {{end}}
    </div>
    {{else}}
    <div class="personal-empty-state">
        <strong>No requests yet</strong>
        <span>Use the Request a book button in the menu whenever the library is missing a title.</span>
    </div>
    {{end}}
</main>
