<main class="requests-shell">
    {{if .Saved}}<div class="notice success" data-i18n="requests_saved_notice">Your request was submitted. A manager will review it, and the outcome will appear here.</div>{{end}}
    {{if .Error}}<div class="notice error">{{.Error}}</div>{{end}}

    <div class="requests-heading">
        <div>
            <span class="personal-eyebrow" data-i18n="requests_heading_eyebrow">Missing a title?</span>
            <h2 data-i18n="requests_heading">My book requests</h2>
        </div>
        <button type="button" class="button primary book-request-open-button" data-i18n="requests_request_button">Request a book</button>
    </div>

    {{if .Requests}}
    <div class="request-list">
        {{range .Requests}}
        <article class="request-card">
            <header class="request-card-head">
                <div>
                    <strong>{{.Title}}</strong>
                    {{if .Author}}<small>by {{.Author}}</small>{{end}}
                </div>
                <span class="request-status request-status-{{.Status}}" data-i18n-status="{{.Status}}">
                    {{if eq .Status "pending"}}Pending review{{else if eq .Status "added"}}Added{{else}}Not found{{end}}
                </span>
            </header>
            {{if .Notes}}<p class="request-notes">{{.Notes}}</p>{{end}}
            {{if eq .Status "added"}}
            <p class="request-resolution request-resolution-added">
                <i class="fa fa-check" aria-hidden="true"></i>
                <span data-i18n="requests_added_prefix">The book was added to the library:</span>
                {{if .BookID}}
                <a href="/books/{{.BookID}}">{{if .BookTitle}}{{.BookTitle}}{{else}}{{end}}</a>
                {{else}}
                {{end}}
                {{if .Message}}<small>{{.Message}}</small>{{end}}
            </p>
            {{else if eq .Status "unavailable"}}
            <p class="request-resolution request-resolution-unavailable">
                <i class="fa fa-times" aria-hidden="true"></i>
                {{if .Message}}{{.Message}}{{else}}<span data-i18n="requests_unavailable_fallback">The book could not be found.</span>{{end}}
            </p>
            {{end}}
            <time class="request-created" datetime="{{.CreatedAt}}"><span data-i18n="requests_requested_on">Requested</span> {{.CreatedText}}</time>
        </article>
        {{end}}
    </div>
    {{else}}
    <div class="personal-empty-state">
        <strong data-i18n="requests_none_title">No requests yet</strong>
        <span data-i18n="requests_none_body">Use the Request a book button in the menu whenever the library is missing a title.</span>
    </div>
    {{end}}
</main>
