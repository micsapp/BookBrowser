<section class="auth-card">
    {{if .Error}}<div class="notice error" role="alert">{{.Error}}</div>{{end}}
    <form method="POST" action="/login" class="stacked-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="next" value="{{.Next}}">
        <label>Email
            <input type="email" name="email" value="{{.Email}}" autocomplete="email" required autofocus>
        </label>
        <label>Password
            <input type="password" name="password" autocomplete="current-password" required>
        </label>
        <button type="submit" class="button primary">Sign in</button>
    </form>
    {{if .GoogleEnabled}}
    <div class="auth-divider"><span>or</span></div>
    <div id="google-login-error" class="notice error hidden" role="alert"></div>
    <div id="g_id_onload"
         data-client_id="{{.GoogleClientID}}"
         data-callback="handleGoogleCredential"
         data-auto_prompt="false"></div>
    <div class="g_id_signin" data-type="standard" data-shape="rectangular" data-theme="outline" data-size="large" data-width="390"></div>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
        function handleGoogleCredential(response) {
            var errorBox = document.getElementById("google-login-error");
            var params = new URLSearchParams();
            params.set("credential", response.credential);
            params.set("csrf_token", "{{.CSRFToken}}");
            fetch("/auth/google", {
                method: "POST",
                credentials: "same-origin",
                headers: {"Content-Type": "application/x-www-form-urlencoded"},
                body: params.toString()
            }).then(function (result) {
                return result.json().then(function (body) {
                    if (!result.ok) throw new Error(body.error || "Google sign-in failed.");
                    return body;
                });
            }).then(function (body) {
                window.location.assign(body.redirect || "/books");
            }).catch(function (error) {
                errorBox.textContent = error.message;
                errorBox.classList.remove("hidden");
            });
        }
    </script>
    {{end}}
    {{if .RegistrationOpen}}
    <p class="auth-note">Need an account? <a href="/register">Register with email</a>.</p>
    {{end}}
</section>
