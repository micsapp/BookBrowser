<main class="auth-shell">
    <section class="auth-showcase" aria-label="BookBrowser">
        <div class="auth-brand-mark" aria-hidden="true">
            <svg viewBox="0 0 48 48" role="img">
                <path d="M10 8.5h11.5c4.2 0 7.5 3.2 7.5 7.2v24c-1.8-2.4-4.4-3.7-7.7-3.7H10z"></path>
                <path d="M38 8.5H26.5c-4.2 0-7.5 3.2-7.5 7.2v20.4c.8-.1 1.6-.1 2.3-.1 3.3 0 5.9 1.3 7.7 3.7 1.8-2.4 4.4-3.7 7.7-3.7H38z"></path>
                <path class="auth-brand-wave" d="M32.5 18.5v8M36 16v13M39.5 19.5v6"></path>
            </svg>
        </div>
        <div>
            <p class="auth-eyebrow">Your personal library</p>
            <h2>Stories, ideas, and knowledge—always within reach.</h2>
            <p class="auth-showcase-copy">Browse your collection, pick up where you left off, and listen while BookBrowser reads along.</p>
        </div>
        <div class="auth-feature-list" aria-label="Features">
            <span><i aria-hidden="true">✓</i> Private library access</span>
            <span><i aria-hidden="true">✓</i> Read-aloud with live highlighting</span>
            <span><i aria-hidden="true">✓</i> Works across your devices</span>
        </div>
    </section>

    <section class="auth-panel" aria-labelledby="sign-in-heading">
        <header class="auth-panel-header">
            <p class="auth-eyebrow">Welcome back</p>
            <h1 id="sign-in-heading">Sign in to your library</h1>
            <p>Continue reading from any device.</p>
        </header>

        {{if .Error}}<div class="notice error" role="alert">{{.Error}}</div>{{end}}

        {{if .GoogleEnabled}}
        <div class="google-signin-wrap">
            <div id="google-button-host" class="google-button-host" aria-label="Continue with Google"></div>
        </div>
        <div id="google-login-error" class="notice error hidden" role="alert"></div>
        <div class="auth-divider"><span>or continue with email</span></div>
        <script>
            function handleGoogleCredential(response) {
                var errorBox = document.getElementById("google-login-error");
                var params = new URLSearchParams();
                params.set("credential", response.credential);
                params.set("csrf_token", "{{.CSRFToken}}");
                fetch("/auth/google", {
                    method: "POST",
                    credentials: "same-origin",
                    headers: {"Content-Type": "application/x-www-form-urlencoded"},
                    body: params.toString()
                }).then(function (result) {
                    return result.json().then(function (body) {
                        if (!result.ok) throw new Error(body.error || "Google sign-in failed.");
                        return body;
                    });
                }).then(function (body) {
                    window.location.assign(body.redirect || "/books");
                }).catch(function (error) {
                    errorBox.textContent = error.message;
                    errorBox.classList.remove("hidden");
                });
            }

            function renderGoogleSignIn() {
                var host = document.getElementById("google-button-host");
                if (!host || !window.google || !google.accounts || !google.accounts.id) return;
                host.textContent = "";
                google.accounts.id.initialize({
                    client_id: "{{.GoogleClientID}}",
                    callback: handleGoogleCredential
                });
                google.accounts.id.renderButton(host, {
                    type: "standard",
                    theme: "outline",
                    size: "large",
                    shape: "rectangular",
                    text: "continue_with",
                    logo_alignment: "left",
                    width: Math.min(400, host.clientWidth || 400)
                });
            }

            window.addEventListener("resize", function () {
                window.clearTimeout(window.bookBrowserGoogleResize);
                window.bookBrowserGoogleResize = window.setTimeout(renderGoogleSignIn, 120);
            });
        </script>
        <script src="https://accounts.google.com/gsi/client" async defer onload="renderGoogleSignIn()"></script>
        {{end}}

        <form method="POST" action="/login" class="stacked-form auth-form">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="next" value="{{.Next}}">
            <label>
                <span>Email address</span>
                <span class="auth-input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6"></path></svg>
                    <input type="email" name="email" value="{{.Email}}" autocomplete="email" placeholder="you@example.com" required autofocus>
                </span>
            </label>
            <label>
                <span>Password</span>
                <span class="auth-input-wrap">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 018 0v3"></path></svg>
                    <input id="login-password" type="password" name="password" autocomplete="current-password" placeholder="Enter your password" required>
                    <button class="password-toggle" type="button" data-password-toggle="login-password" aria-label="Show password">Show</button>
                </span>
            </label>
            <button type="submit" class="button primary auth-submit">Sign in <span aria-hidden="true">→</span></button>
        </form>

        {{if .RegistrationOpen}}
        <p class="auth-note">New to {{.SiteName}}? <a href="/register">Create an account</a></p>
        {{end}}
        <p class="auth-security-note"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.6-2.8 8-7 10-4.2-2-7-5.4-7-10V6z"></path><path d="M9 12l2 2 4-4"></path></svg>Your session is protected and securely stored.</p>
    </section>
</main>

<script>
    document.addEventListener("click", function (event) {
        var button = event.target.closest("[data-password-toggle]");
        if (!button) return;
        var input = document.getElementById(button.getAttribute("data-password-toggle"));
        if (!input) return;
        var showing = input.type === "text";
        input.type = showing ? "password" : "text";
        button.textContent = showing ? "Show" : "Hide";
        button.setAttribute("aria-label", showing ? "Show password" : "Hide password");
    });
</script>
