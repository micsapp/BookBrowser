<section class="admin-shell">
    <div class="admin-cards">
        <a class="admin-card" href="/admin/library">
            <strong>Library</strong>
            <span>{{.BookCount}} indexed books</span>
            <small>Upload, remove, or rescan books</small>
        </a>
        <a class="admin-card" href="/admin/library/add">
            <strong>Add books</strong>
            <span>From LibGen mirrors</span>
            <small>Search, select, and add books, then resync</small>
        </a>
        <a class="admin-card" href="/admin/requests">
            <strong>Book requests</strong>
            <span>{{.PendingRequests}} pending</span>
            <small>Review reader requests and reply with the outcome</small>
        </a>
        {{if .IsAdmin}}<a class="admin-card" href="/admin/copyright">
            <strong data-i18n="admin_copyright_tab">Copyright claims</strong>
            <span>{{.PendingCopyrightClaims}} <span data-i18n="admin_copyright_pending">pending</span></span>
            <small data-i18n="admin_copyright_card_help">Review reports and remove affected books</small>
        </a>{{end}}
        {{if .IsAdmin}}<a class="admin-card{{if .OpenSystemAlerts}} admin-card-alert{{end}}" href="/admin/system">
            <strong data-i18n="admin_system_tab">System alerts</strong>
            <span>{{.OpenSystemAlerts}} <span data-i18n="admin_system_open">ongoing</span></span>
            <small data-i18n="admin_system_card_help">Service failures detected by background checks</small>
        </a>{{end}}
        {{if .IsAdmin}}
        <a class="admin-card" href="/admin/users">
            <strong>Users</strong>
            <span>{{.UserCount}} accounts</span>
            <small>Manage roles and account access</small>
        </a>
        <a class="admin-card" href="/admin/settings">
            <strong>Settings</strong>
            <span>Library access and sign-up</span>
            <small>Configure site behavior</small>
        </a>
        <a class="admin-card" href="/implementation.md">
            <strong>Implementation guide</strong>
            <span>Authentication and RBAC checklist</span>
            <small>View the served Markdown plan</small>
        </a>
        {{end}}
    </div>
</section>
