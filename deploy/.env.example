# BookBrowser deployment configuration used by deploy.sh
#
# REQUIRED (deploy.sh refuses to run without these set to a real value):
#   BOOKBROWSER_GOOGLE_CLIENT_ID
#       Public Google OAuth web client ID for this domain's login. Copy the
#       value out of the target server's existing google.env when known, or
#       create a new web client in Google Cloud Console.
#
# Optional overrides (defaults are used when unset):
#   DEPLOY_DOMAIN          Public site name, e.g. ebook.micstec.com. Only
#                          needed when DEPLOY_NGINX is enabled.
#   WEB_ADDR               Web bind address, default 127.0.0.1:8092
#                          (aws11 mode defaults to 127.0.0.1:8091).
#   BOOK_DIR               Directory that holds the books, default /home/mli/books
#   DATA_DIR               Auth/settings directory, default $BOOK_DIR/.bookbrowser
#   DEPLOY_SSH_USER        SSH user for --remote; defaults to the local user.
#   DEPLOY_SERVICE_MODE    user | aws11   (auto: --remote => aws11, local => user)
#                              user  : systemd user units for web + TTS
#                              aws11 : runit launcher for web, system-level
#                                      systemd unit for TTS (uses sudo)
#   GOARCH                 Binary target architecture, default amd64.
#   DEPLOY_NGINX           1 to also generate/check the nginx site (needs sudo).
#
# TTS deployment (auto-deployed on this target when not already running):
#   TTS_LISTEN               default 127.0.0.1
#   TTS_PORT                 default 8094
#   TTS_CACHE                default /var/cache/bookbrowser-tts
#   TTS_VENV                 default /home/mli/ttsvenv
#   TTS_MAX_CONCURRENCY      default 8
#   TTS_PARALLEL_CHARS       default 1200
#   TTS_PARALLEL_SLOTS       default 8
#   TTS_SYNTH_TIMEOUT        default 60

BOOKBROWSER_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com